# Copy to .env.secure-fresh (do not commit). Used with docker-compose.secure-fresh.yml.
FOREMAN_IMAGE=foreman-local:security-hardening-5.0-REPLACE_SHORTSHA
POSTGRES_PASSWORD=change_me_secure_fresh_db
ENCRYPTION_KEY=
SECRET_KEY_BASE=
SEED_ADMIN_USER=secureadmin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=secureadmin@example.com
FOREMAN_APPLY_SECURE_DEFAULTS=true
FOREMAN_REQUIRE_SSL=false
FOREMAN_SECURITY_EVENTS_ENABLED=true
FOREMAN_SECURITY_EVENTS_URL=tcp://security-collector:1514
FOREMAN_SECURITY_COLLECTOR_PORT=1514
SECURITY_COLLECTOR_RETENTION_DAYS=30
SECURITY_COLLECTOR_ROTATE_BYTES=10485760
# SECURITY_COLLECTOR_HMAC_KEY=
FOREMAN_SIGNING_ENABLED=false
