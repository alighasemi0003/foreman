<% title _("Change your password") %>

<%= form_for @user do |f| %>
  <%= alert :class => 'alert-warning',
            :header => _('Password change required'),
            :text => _('You must set a new password before you can continue using Foreman. The new password must be different from your current password.'),
            :close => false %>

  <%= base_errors_for @user %>
  <% password_errors = (@user.errors[:current_password] + @user.errors[:password] + @user.errors[:password_confirmation]).uniq %>
  <% if password_errors.present? %>
    <%= alert :class => 'alert-danger',
              :header => _('Unable to change password'),
              :text => password_errors.to_sentence,
              :close => false %>
  <% end %>

  <div id='password'>
    <%= password_f f, :current_password, :label => _('Current password'), :placeholder => '', :autocomplete => 'current-password' %>
    <%= password_f f, :password, :label => _('New password'), :placeholder => '', :autocomplete => 'new-password' %>
    <%= password_f f, :password_confirmation, :label => _('Verify'), :placeholder => '', :autocomplete => 'new-password' %>
  </div>

  <%= submit_or_cancel f, false, :cancel_path => logout_users_path, :button_text => _('Change Password') %>
<% end %>
