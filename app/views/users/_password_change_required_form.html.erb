<%= form_for @user do |f| %>
  <%= alert :class => 'alert-warning',
            :header => _('Password change required'),
            :text => _('You must set a new password before you can continue using Foreman. The new password must be different from your current password.'),
            :close => false %>

  <%= base_errors_for @user %>
  <% if @user.errors[:password].present? || @user.errors[:current_password].present? || @user.errors[:password_confirmation].present? %>
    <%= alert :class => 'alert-danger',
              :header => _('Unable to change password'),
              :text => (@user.errors[:current_password] + @user.errors[:password] + @user.errors[:password_confirmation]).uniq.to_sentence,
              :close => false %>
  <% end %>

  <div id='password'>
    <%= password_f f, :current_password, :label => _('Current password'), :placeholder => '', :autocomplete => 'current-password' %>
    <%= react_component('PasswordStrength',
                        {data: {:className => 'form-control',
                               :id => 'user_password',
                               :userInputIds => ['user_login'],
                               :name => 'user[password]',
                               :verify => {name: 'user[password_confirmation]', :error => f.object.errors[:password_confirmation].present? ? f.object.errors[:password_confirmation].to_sentence : false},
                               :error => (f.object.errors[:password].presence || f.object.errors[:password_hash].presence)&.to_sentence || false,
                               :required => true }}) %>
  </div>

  <%= submit_or_cancel f, false, :cancel_path => logout_users_path, :submit_text => _('Change Password') %>
<% end %>
