# Copy to .env for local overrides (never commit .env).
# All values below are local-development defaults only — change before any shared/prod use.

# Published HTTP port on the host (change if 3000 is already taken).
FOREMAN_HTTP_PORT=3000
# Optional bind address (default loopback). Use 0.0.0.0 only on trusted lab networks.
# MY_DOCKER_IP=127.0.0.1

# Optional VNC console host ports (5910-5930):
#   docker compose -f docker-compose.yml -f docker-compose.vnc.yml up -d app

# Image tag produced by `docker compose build app`.
FOREMAN_IMAGE=foreman-local:security-hardening-5.0

# Postgres (must match DATABASE_URL user/password/db name).
POSTGRES_USER=foreman
POSTGRES_PASSWORD=foreman
POSTGRES_DATABASE=foreman
DATABASE_URL=postgres://foreman:foreman@db/foreman?pool=5

# Local HTTP lab stack only. Do not use FOREMAN_REQUIRE_SSL=false in production.
FOREMAN_REQUIRE_SSL=false
FOREMAN_FQDN=foreman.example.com
FOREMAN_DOMAIN=example.com

# Optional: set only for a disposable local seed if you need a known password.
# If unset, `db:seed` prints a one-time random admin password to the app logs.
# SEED_ADMIN_USER=admin
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_EMAIL=admin@example.com
