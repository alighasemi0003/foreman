# Copy to .env for local overrides (never commit .env).
# All values below are local-development defaults only — change before any shared/prod use.

# Published HTTP port on the host (change if 3000 is already taken).
FOREMAN_HTTP_PORT=3000
# Optional bind address (default loopback). Use 0.0.0.0 only on trusted lab networks.
# MY_DOCKER_IP=127.0.0.1

# Optional VNC console host ports (5910-5930):
#   docker compose -f docker-compose.yml -f docker-compose.vnc.yml up -d app

# Image tag produced by `docker compose build app`.
FOREMAN_IMAGE=foreman-local:security-hardening-5.0

# Postgres (must match DATABASE_URL user/password/db name).
POSTGRES_USER=foreman
POSTGRES_PASSWORD=foreman
POSTGRES_DATABASE=foreman
DATABASE_URL=postgres://foreman:foreman@db/foreman?pool=5

# Puma / AR alignment (F-027). Keep FOREMAN_PUMA_THREADS_MAX <= pool, and
# FOREMAN_SIDEKIQ_CONCURRENCY <= pool. See docs/connection-capacity.md.
RAILS_MAX_THREADS=5
FOREMAN_PUMA_THREADS_MIN=0
FOREMAN_PUMA_THREADS_MAX=5
FOREMAN_PUMA_WORKERS=2
FOREMAN_SIDEKIQ_CONCURRENCY=5

# Local HTTP lab stack only. Do not use FOREMAN_REQUIRE_SSL=false in production.
FOREMAN_REQUIRE_SSL=false
FOREMAN_FQDN=foreman.example.com
FOREMAN_DOMAIN=example.com

# Optional: set only for a disposable local seed if you need a known password.
# If unset, `db:seed` prints a one-time random admin password to the app logs.
# SEED_ADMIN_USER=admin
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_EMAIL=admin@example.com

# Required for encrypting LDAP / compute-resource / proxy / BMC / JWT secrets at rest.
# Generate once (64 hex chars) and keep stable across restarts — never commit the real value.
# Example generator: python3 -c 'import secrets; print(secrets.token_hex(32))'
# ENCRYPTION_KEY=
# Or mount a key file and set:
# ENCRYPTION_KEY_FILE=/run/secrets/foreman_encryption_key

# F-041 centralized security-event forwarder (optional lab / SIEM collector).
# Compose overlay: docker-compose.logging.yml (security-collector + volume).
# FOREMAN_SECURITY_EVENTS_ENABLED=false
# FOREMAN_SECURITY_EVENTS_URL=tcp://security-collector:1514
# FOREMAN_SECURITY_EVENTS_QUEUE=1000
# FOREMAN_SECURITY_COLLECTOR_PORT=1514
