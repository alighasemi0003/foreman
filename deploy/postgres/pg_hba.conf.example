# F-040 example pg_hba.conf fragment for a dedicated DB tier.
# Replace APP_TIER_CIDR and use scram-sha-256 when the server/password hash supports it.

# TYPE  DATABASE  USER               ADDRESS         METHOD
local   all       postgres                           peer
local   all       all                                peer

# Local maintenance only
host    all       all                127.0.0.1/32    scram-sha-256
host    all       all                ::1/128         scram-sha-256

# Application tier — TLS required
hostssl foreman   foreman_app        APP_TIER_CIDR   scram-sha-256
hostssl foreman   foreman_migrator   APP_TIER_CIDR   scram-sha-256

# Explicit deny everything else (optional if firewall already denies)
# hostssl all all 0.0.0.0/0 reject
